{
  "name": "@pogo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --sourcemap --outfile=dist/index.js --external:fastify --external:@fastify/* --external:socket.io --external:@prisma/client --external:jose --external:nodemailer --external:zod"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^10.1.7",
    "@pogo/shared": "workspace:*",
    "@prisma/client": "^5.22.0",
    "fastify": "^5.1.0",
    "jose": "^5.9.6",
    "nodemailer": "^10.2.1",
    "prisma": "^5.22.0",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^8.0.2",
    "esbuild": "^0.24.0",
    "pino-pretty": "^13.0.0",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2"
  }
}
