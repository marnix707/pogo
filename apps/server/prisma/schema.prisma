generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String        @id @default(uuid())
  nickname     String
  avatar       String
  isGuest      Boolean       @default(true)
  email        String?       @unique
  passwordHash String?
  registeredAt DateTime?
  createdAt    DateTime      @default(now())
  /// 'user' | 'moderator' | 'admin' (admin panel powers)
  role         String        @default("user")
  /// Developer tag: "(dev)" is shown behind the name.
  isDev        Boolean       @default(false)
  /// Text before / after the nickname, handed out by a developer (shown to everybody).
  prefix       String?
  suffix       String?
  lastIp       String?
  lastSeenAt   DateTime?
  image        UserImage?
  results      GameResult[]
}

/// An uploaded profile picture (small, resized by the client). Stored here because the host has no disk.
model UserImage {
  userId    String   @id
  mime      String
  data      Bytes
  version   Int      @default(1)
  updatedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A one-time emailed code (stored hashed) for registering or resetting a password.
model EmailCode {
  id        String   @id @default(uuid())
  email     String
  purpose   String
  codeHash  String
  userId    String?
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([email, purpose])
}

/// One row per human player per finished game.
model GameResult {
  id       String   @id @default(uuid())
  userId   String
  matchId  String
  gameId   String
  rank     Int
  score    Int
  players  Int
  bots     Int
  playedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, matchId])
  @@index([gameId, score])
  @@index([userId, gameId])
}

/// A ban on an account and/or an IP address. expiresAt null = permanent; revokedAt = lifted early.
model Ban {
  id        String    @id @default(uuid())
  userId    String?
  nickname  String
  ip        String?
  reason    String
  byId      String
  byName    String
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?

  @@index([userId])
  @@index([ip])
}

/// What staff did (bans, kicks, role changes), newest last.
model AuditLog {
  id         String   @id @default(uuid())
  at         DateTime @default(now())
  actorId    String
  actorName  String
  action     String
  targetId   String?
  targetName String
  detail     String

  @@index([at])
}
