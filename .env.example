# Copy to .env (`make env` does this automatically). Never commit .env.

# --- Postgres ---
POSTGRES_USER=pogo
POSTGRES_PASSWORD=pogo_dev_password
POSTGRES_DB=pogo
# Host port (bound to 127.0.0.1 only) for inspecting the DB with a local client
DB_PORT=5433

# --- Server ---
SERVER_PORT=3000
# Used inside the compose network (host "db" is the compose service name)
DATABASE_URL=postgresql://pogo:pogo_dev_password@db:5432/pogo?schema=public
# Secret for signing guest/user tokens. CHANGE in any non-local environment.
JWT_SECRET=dev-only-change-me-dev-only-change-me
# Comma-separated allowed browser origins for CORS ("*" allows all; dev only)
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# --- Web ---
WEB_PORT=5173
# Where the Vite dev server proxies /api and /socket.io to
API_PROXY_TARGET=http://server:3000

# --- Dev tooling ---
# Poll for file changes (needed for reliable hot reload on WSL/Docker bind mounts)
CHOKIDAR_USEPOLLING=true
# Comma-separated LAN IPs to print as phone URLs. `make up` fills this automatically.
HOST_LAN_IPS=

# --- Gameplay timing (server) ---
# Default seconds per turn action in new rooms (0 = no timer)
TURN_TIME_SEC=90
# Seconds to wait for a disconnected player before auto-skipping them / dropping them from a lobby
DISCONNECT_GRACE_SEC=20
# Seconds an unattended room is kept before being deleted
ROOM_TTL_SEC=600
# Guest signups allowed per IP per minute (server default 10; dev compose default 100)
GUEST_SIGNUP_LIMIT_PER_MIN=100
# Profanity filter for chat (masks words) and guest nicknames (refuses them): on | off
PROFANITY_FILTER=on

# --- Production only (Render + Neon; set in the Render dashboard, never committed) ---
# DATABASE_URL: Neon connection string (add ?sslmode=require; pooled hosts also need &pgbouncer=true)
# DIRECT_URL:   Neon *direct* (non-pooled) string, used for migrations. Optional; defaults to DATABASE_URL.
